{
  "name": "forge-harness",
  "version": "1.0.1",
  "private": true,
  "description": "A TypeScript coding-agent Runtime for governed execution, evidence, isolation, and coordination.",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "bin": {
    "forge-harness": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean:runs": "npm run --silent build && node dist/cli/cleanup.js",
    "demo:portfolio": "npm run --silent build && node dist/portfolio/cli.js",
    "demo:portfolio:live": "npm run --silent build && node dist/portfolio/liveCli.js",
    "docs:check": "node scripts/check-doc-links.mjs",
    "evidence": "npm run --silent build && node dist/cli/evidence.js",
    "eval": "npm run --silent build && node dist/eval/cli.js",
    "smoke:c17c-capstone": "vitest run test/smoke/c17cCapstone.test.ts",
    "smoke:c17c-child": "vitest run test/smoke/c17cChildIntegration.test.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "start": "node dist/cli/index.js"
  },
  "keywords": [
    "agent",
    "coding-agent",
    "harness",
    "runtime",
    "typescript",
    "tool-governance",
    "multi-agent-coordination"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dotenv": "^17.2.3",
    "openai": "^5.23.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.8.0",
    "vitest": "^4.0.15"
  }
}
